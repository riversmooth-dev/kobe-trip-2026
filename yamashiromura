<script>
(function(){
  var storageKey="minamiyamashiro-drive-20260807-checks";
  var boxes=document.querySelectorAll("[data-trip-check]");
  var saved={};
  try{saved=JSON.parse(localStorage.getItem(storageKey)||"{}");}catch(e){saved={};}
  function save(){
    var state={};
    boxes.forEach(function(box){
      state[box.id]=box.checked;
      box.closest(".check-item").classList.toggle("done",box.checked);
    });
    try{localStorage.setItem(storageKey,JSON.stringify(state));}catch(e){}
  }
  boxes.forEach(function(box){
    box.checked=Boolean(saved[box.id]);
    box.closest(".check-item").classList.toggle("done",box.checked);
    box.addEventListener("change",save);
  });
})();
</script>
